# Local testing settings. Plain values: no quotes or export statements.
NEW_RELIC_LICENSE_KEY=replace-with-your-ingest-license-key
NEW_RELIC_APP_NAME=redis-rate-limiter-demo
NEW_RELIC_APPLICATION_LOGGING_ENABLED=true
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
NEW_RELIC_OTLP_METRICS_URL=https://otlp.nr-data.net/v1/metrics
# Required for Java-agent log forwarding; use an absolute path.
NEW_RELIC_AGENT_JAR=/actual/path/newrelic.jar
